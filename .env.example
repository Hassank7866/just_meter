# ========================================================
# Mobile ANPR / Just Meter - Environment Configuration
# ========================================================

# Authentication. Set a long random value in your local .env before deployment.
AUTH_JWT_SECRET=replace-with-a-long-random-secret
# Optional demo account password overrides. Defaults are shown in the login page.
DEMO_ADMIN_PASSWORD=admin123
DEMO_TRANSPORT_PASSWORD=transport123
DEMO_SUPERVISOR_PASSWORD=supervisor123
DEMO_AUDITOR_PASSWORD=auditor123

# Docker PostgreSQL (keep URL-safe characters in this Compose password).
POSTGRES_PASSWORD=just-meter-local-demo
# Host ports. Override these in your ignored local .env if the ports are unavailable.
POSTGRES_PORT=5433
FRONTEND_PORT=5173

# Optional mobile scanner: start the mobile-tunnel profile, copy its HTTPS URL here,
# then recreate the frontend service. Leave empty for laptop-only use.
MOBILE_SCANNER_URL=
# Compose configures DATABASE_URL using the db service hostname.
# Demo users are seeded on first startup; password changes here do not reset existing users.

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME="Govt Fleet Command"
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Application Base URL (for email links and public access)
BASE_URL=http://localhost:8000

# Meta WhatsApp Cloud API Configuration (Optional)
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_API_VERSION=v20.0

# ANPR Detection & Sensitivity Settings (Optional)
MIN_PLATE_CONFIDENCE=0.70
MIN_VEHICLE_CONFIDENCE=0.45
DUPLICATE_COOLDOWN_SECONDS=15
