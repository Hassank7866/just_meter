# ========================================================
# Mobile ANPR / Just Meter - Environment Configuration
# ========================================================

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-account@gmail.com
SMTP_FROM_NAME="Govt Fleet Command"
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Application Base URL (for email links and public access)
BASE_URL=http://127.0.0.1:8000

# Meta WhatsApp Cloud API Configuration (Optional)
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_API_VERSION=v20.0

# ANPR Detection & Sensitivity Settings (Optional)
MIN_PLATE_CONFIDENCE=0.70
MIN_VEHICLE_CONFIDENCE=0.45
DUPLICATE_COOLDOWN_SECONDS=15
